{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": { "@app/*": ["./reference/src/*"], "@test/*": ["./test-support/*"] }
  },
  "include": [
    "reference/**/*.ts",
    "exercises/**/*.ts",
    "test-support/**/*.ts",
    "scripts/**/*.ts",
    "vitest*.ts"
  ]
}
