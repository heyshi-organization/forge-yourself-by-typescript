# これはダミー値のみのサンプルです。実際のトークンを書いたファイルは .env に置き、コミットしないこと。
# 使い方: cp .env.example .env

# fake: GitHubに接続せずメモリ上のFakeで動作する(学習・動作確認用)
# octokit: 実際のGitHub APIを呼ぶ(GITHUB_TOKEN が必要)
GITHUB_CLIENT=fake
# GITHUB_TOKEN=<fine-grained PATをここに。リポジトリ作成権限のみ>

HOST=127.0.0.1
PORT=3000
DB_PATH=./data/app.sqlite
LOG_LEVEL=info

GITHUB_TIMEOUT_MS=10000
GITHUB_MAX_ATTEMPTS=4
PROCESSING_LEASE_MS=300000
